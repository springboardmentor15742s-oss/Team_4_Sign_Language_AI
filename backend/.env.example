# Backend environment example — copy to .env
APP_NAME="Sign Language Learning & Assessment Platform API"
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./signlang.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
